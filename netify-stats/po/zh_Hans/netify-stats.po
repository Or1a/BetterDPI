#, c-format
msgid "Download %s, upload %s"
msgstr "下载 %s，上传 %s"

#, c-format
msgid "Download %s · Upload %s"
msgstr "下载 %s · 上传 %s"

#, c-format
msgid "Requested: %s; actual: %s. %s"
msgstr "目标：%s；实际：%s。%s"

msgid "Enabled"
msgstr "开启"

msgid "Disabled"
msgstr "关闭"

msgid "The setting has not been fully applied."
msgstr "设置尚未完整应用。"

#, c-format
msgid "%s (currently unavailable)"
msgstr "%s（当前不可用）"

#, c-format
msgid "Could not save the interface: %s"
msgstr "接口保存失败：%s"

