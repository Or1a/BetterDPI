#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

start_service() {
	# Lifecycle checks rewrite this constant in temporary script copies.
	local ns_root='' ns_status
	"$ns_root/usr/bin/python3" - "$ns_root" <<'PY'
import sys
root = sys.argv[1]
sys.path.insert(0, root + '/usr/lib/netify-stats')
import netify_storage
if root:
    netify_storage.CONFIG_PATH = root + '/etc/netify-stats.json'
sys.exit(0 if netify_storage.read_enabled() else 3)
PY
	ns_status=$?
	[ "$ns_status" -eq 3 ] && return 0
	[ "$ns_status" -eq 0 ] || return "$ns_status"
	mkdir -p "$ns_root/tmp/netify-stats" "$ns_root/var/run/netify-stats" || return 1
	procd_open_instance
	procd_set_param command "$ns_root/usr/bin/python3" "$ns_root/usr/sbin/netify-stats-collector"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="8192 8192"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger netifyd
}
