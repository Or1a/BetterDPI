#, c-format
msgid "Download %s, upload %s"
msgstr "下载 %s，上传 %s"

#, c-format
msgid "Download %s · Upload %s"
msgstr "下载 %s · 上传 %s"

#, c-format
msgid "Requested: %s; actual: %s. %s"
msgstr "目标：%s；实际：%s。%s"

