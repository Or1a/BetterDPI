#, c-format
msgid "Download %s, upload %s"
msgstr "下載 %s，上傳 %s"

#, c-format
msgid "Download %s · Upload %s"
msgstr "下載 %s · 上傳 %s"

#, c-format
msgid "Requested: %s; actual: %s. %s"
msgstr "目標：%s；實際：%s。%s"

msgid "Enabled"
msgstr "開啟"

msgid "Disabled"
msgstr "關閉"

msgid "The setting has not been fully applied."
msgstr "設定尚未完整套用。"

#, c-format
msgid "%s (currently unavailable)"
msgstr "%s（目前無法使用）"

#, c-format
msgid "Could not save the interface: %s"
msgstr "介面儲存失敗：%s"

msgid "Statistics interface"
msgstr "統計介面"

#, c-format
msgid "Bound interface: %s"
msgstr "已綁定：%s"

msgid "No interface is bound"
msgstr "尚未綁定介面"

#, c-format
msgid "%s of traffic could not be attributed to devices during this collection session. Historical statistics are incomplete."
msgstr "本輪收集累計有 %s 流量無法歸屬至裝置，相關歷史統計不完整。"

#, c-format
msgid "Current record storage: %s (including database and journal)"
msgstr "目前記錄占用 %s（含資料庫與日誌）"

#, c-format
msgid "Could not save: %s"
msgstr "儲存失敗：%s"

msgid "Record limit (MiB)"
msgstr "記錄上限（MiB）"

msgid "Download"
msgstr "下載"

msgid "Upload"
msgstr "上傳"

msgid "No attributable data"
msgstr "暫無可歸屬的資料"

msgid "No data yet. Netify is identifying new connections."
msgstr "尚無資料，Netify 正在識別新連線。"

msgid "Devices generating this traffic"
msgstr "由哪些裝置產生"

msgid "Websites / services"
msgstr "存取的網站 / 服務"

msgid "Loading details…"
msgstr "正在載入詳細資料…"

msgid "Previous"
msgstr "上一頁"

msgid "Next"
msgstr "下一頁"

msgid "Application ranking pages"
msgstr "應用程式排行分頁"

msgid "No device data"
msgstr "暫無裝置資料"

msgid "No trend data"
msgstr "暫無趨勢資料"

msgid "Running"
msgstr "仍在執行"

msgid "Stopped"
msgstr "已停止"

msgid "Some services are running"
msgstr "部分服務正在執行"

msgid "Not bound"
msgstr "未綁定"

msgid "Confirm and save"
msgstr "確認儲存"

msgid "Interface traffic"
msgstr "介面流量"

msgid "Receive RX"
msgstr "接收 RX"

msgid "Transmit TX"
msgstr "傳送 TX"

msgid "The interface was reset. Traffic during the reset could not be fully measured."
msgstr "介面曾重設，重設期間無法完整計量。"

msgid "No records for this interface"
msgstr "此介面暫無記錄"

msgid "Select an interface to measure"
msgstr "請選擇統計介面"

msgid "Device traffic trend"
msgstr "裝置流量趨勢"

msgid "Community rules could not be loaded. Showing domains instead."
msgstr "社群規則載入失敗，暫按網域顯示。"

msgid "Collection is temporarily unavailable. Showing historical data."
msgstr "收集暫時無法使用，目前顯示歷史資料。"

msgid "Proxy connection attribution failed. Some device statistics may be incomplete."
msgstr "代理連線歸屬失敗，部分裝置統計可能不完整。"

msgid "Connection metadata recovery failed. Some device or application statistics may be incomplete."
msgstr "連線資訊復原失敗，部分裝置或應用程式統計可能不完整。"

msgid "Device download"
msgstr "裝置下載"

msgid "Device upload"
msgstr "裝置上傳"

msgid "Internet → device"
msgstr "網際網路 → 裝置"

msgid "Device → Internet"
msgstr "裝置 → 網際網路"

msgid "Interface counters are temporarily unavailable."
msgstr "介面計數暫時無法使用。"

msgid "Statistics storage maintenance failed. Check the capacity setting and available space."
msgstr "統計儲存維護異常，請檢查容量設定及可用空間。"

msgid "Application and website ranking"
msgstr "應用程式與網站排行"

msgid "Device ranking"
msgstr "裝置排行"

msgid "Device ranking pages"
msgstr "裝置排行分頁"

msgid "Refresh failed. The previous results have been kept. Please try again."
msgstr "重新整理失敗，已保留上次結果。請稍後重試。"

msgid "All devices"
msgstr "全部裝置"

msgid "Time range"
msgstr "時間範圍"

msgid "All"
msgstr "全部"

msgid "Last 1 hour"
msgstr "最近1小時"

msgid "Last 5 hours"
msgstr "最近5小時"

msgid "Last 24 hours"
msgstr "最近24小時"

msgid "Last 7 days"
msgstr "最近7天"

msgid "Device"
msgstr "裝置"

msgid "Sort by"
msgstr "排序依據"

msgid "Total traffic"
msgstr "總流量"

msgid "Connections"
msgstr "連線數"

msgid "Order"
msgstr "順序"

msgid "Highest first"
msgstr "從高到低"

msgid "Lowest first"
msgstr "從低到高"

msgid "Refresh"
msgstr "重新整理"

msgid "DPI Traffic Analysis"
msgstr "DPI 流量分析"

msgid "Traffic analysis"
msgstr "流量分析"

msgid "Retry applying"
msgstr "重試套用"

msgid "Record storage limit in MiB"
msgstr "記錄容量上限 MiB"

msgid "Enter 0 (unlimited) or an integer from 4 to 4096 MiB."
msgstr "請輸入 0（不限）或 4–4096 MiB 的整數。"

msgid "When the storage limit is reached, the oldest hours of statistics will be deleted first. Save this setting?"
msgstr "達到容量上限時，將按最早小時優先刪除統計記錄。儲存此設定？"

msgid "The server did not confirm the saved value. Refresh and try again."
msgstr "伺服器未確認儲存值，請重新整理後重試"

msgid "Saved. The collector will apply the setting automatically."
msgstr "已儲存；收集器會自動套用。"

msgid "Save storage setting"
msgstr "儲存容量設定"

msgid "Storage settings"
msgstr "儲存設定"

msgid "0 means unlimited. At the limit, the oldest hours are removed first. Writes may temporarily exceed the limit. Records stay in memory and are cleared on reboot; the capacity setting is kept."
msgstr "0 為不限；達到上限按最早小時淘汰。寫入時可能短暫超出。記錄仍在記憶體，重新啟動後清空；容量設定會保留。"

msgid "Capacity must be 0 (unlimited) or an integer from 4 to 4096 MiB"
msgstr "容量必須為 0（不限）或 4–4096 MiB 的整數"

msgid "Settings are being saved. Please try again."
msgstr "設定正在儲存，請稍後重試"

msgid "Statistics migration verification failed; original data was preserved."
msgstr "統計移轉驗證失敗，已保留原始資料"

msgid "Storage cleanup is waiting for active queries to finish."
msgstr "日誌被讀取占用，容量回收等待查詢結束"

msgid "Storage cleanup is not finished; oldest hours will continue to be removed."
msgstr "容量回收尚未完成，將繼續按最早小時清理"

msgid "Analysis toggle timed out. Please try again."
msgstr "開關操作逾時，請重試"

msgid "Services did not fully start. Please try again."
msgstr "服務未完整啟動，請重試"

msgid "Services did not fully stop. Please try again."
msgstr "服務未完整停止，請重試"

msgid "Another analysis toggle is in progress. Please try again."
msgstr "已有開關操作正在執行，請稍後重試"

msgid "Select an interface that exists on this device."
msgstr "請選擇目前裝置上存在的介面"

msgid "Invalid enabled setting"
msgstr "分析開關設定無效"

msgid "enabled must be boolean"
msgstr "分析開關必須為開啟或關閉"

msgid "Invalid interface setting"
msgstr "介面設定無效"

msgid "Invalid interface name"
msgstr "介面名稱無效"

msgid "Negative interface counter"
msgstr "介面計數不能為負數"

msgid "Unknown destination"
msgstr "未識別目標"

msgid "Douyin"
msgstr "抖音"

msgid "WeChat"
msgstr "微信"

msgid "Tencent"
msgstr "騰訊"

msgid "Bilibili"
msgstr "嗶哩嗶哩"

msgid "Huawei"
msgstr "華為"

msgid "Xiaomi"
msgstr "小米"

msgid "JD.com"
msgstr "京東"

msgid "Taobao"
msgstr "淘寶"

msgid "Native Netify classification"
msgstr "Netify 原生識別"

msgid "Community domain rules"
msgstr "社群網域規則"

msgid "Domain only"
msgstr "僅識別網域"

msgid "Unidentified"
msgstr "未識別"

#, c-format
msgid "%s (%s)"
msgstr "%s（%s）"

#, c-format
msgid "Analysis setting could not be fully applied: %s"
msgstr "開關尚未完整套用，請重試：%s"
